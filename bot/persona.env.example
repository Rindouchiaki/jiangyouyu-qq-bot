# 人设插件配置：复制为 persona.env 后使用
# 一键更新会按这份样例重写 persona.env：账号、密钥、路径和自己加的项保留，调参项换成这里的新值（旧文件备份成 persona.env.bak-时间）。
# 想长期保留自己调过的值，写进同目录的 persona.local.env（格式一样，只写要改的几行），它会盖过 persona.env，一键更新不碰。
# 对应要求：像普通群友、每条消息 ≤20 字（一次可以发两三条）、不暴露 AI、口语化、有主见

# 只让这个 QQ 号发言（另一个号的事件会被忽略）
BOT_UIN=100000001
# 开发者（管理指令、好感保底「有好感」）写死在 bot\devs.py，不在这里配
# 群友平时怎么叫它：提到这些词也算叫它（英文逗号分隔）
NICKNAMES=酱油鱼,大肥鱼,鲸鱼娘

# 任意 OpenAI 兼容接口：DeepSeek / OpenAI / 本地 vLLM 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 每条消息上限（字）；长的会按标点拆成几条发
REPLY_MAX_CHARS=20
# 直接问事（问号、啥、怎么、能不能）时一次回话总共放宽到几个字，免得答不完整
REPLY_MAX_CHARS_QUESTION=40
# 一次回话最多发几条、总共多少字（求助多一条）
REPLY_MAX_LINES=3
REPLY_TOTAL_CHARS=60
# 求助 / 联网时一次回话的输出 token 上限
REPLY_HELP_MAX_TOKENS=240
# 每个会话保留多少条上下文
HISTORY_SIZE=40

# ---- 拟人节奏：等对方说完再一起回，按字数打字 ----
# 收到消息先等几秒看还有没有下文：群里 / 私聊冷清时等 DEBOUNCE_QUIET 秒，正聊着等 DEBOUNCE_BUSY 秒；
# 同一个人接着发再续 DEBOUNCE_SAME_USER 秒，换人发续 DEBOUNCE_OTHER_USER 秒，先发图的至少等 DEBOUNCE_MEDIA 秒；
# 一批最多等 DEBOUNCE_MAX 秒，喊名字时最多再等 DEBOUNCE_AT 秒；群里被 @ 不等，马上回
DEBOUNCE_QUIET=3
DEBOUNCE_BUSY=5
DEBOUNCE_SAME_USER=3
DEBOUNCE_OTHER_USER=0.8
DEBOUNCE_MEDIA=4
DEBOUNCE_AT=2.5
DEBOUNCE_MAX=12
# 打字速度（秒/字）和单条最长打字时间；私聊里隔了一阵的消息偶尔晚几十秒才回的概率
TYPING_SEC_PER_CHAR=0.25
TYPING_MAX_SEC=8
REPLY_LATE_PROB=0.1
# 群里被 @ 时尽快回：不停顿，每条打字最多等几秒（私聊和闲聊照上面的慢慢来）
REPLY_AT_TYPING_MAX=1.5
# 群里只喊名字没 @：照常攒批（最多再等 DEBOUNCE_AT 秒），停顿按正聊着算（0.5~2.5 秒），每条打字最多几秒
REPLY_CALLED_TYPING_MAX=4
# 打字时对方又补了话：带上新消息重想，最多几次，之后照发
REPLY_RESTART_MAX=2
# 回话路数（吐槽/接梗/反问…）在同一个会话里保持多久（秒），不每句换一种
FLAVOR_TTL=600
# 群里感兴趣的话题（bot\knowledge\topics.json 的类别，英文逗号分隔）：聊到时插话概率乘 INTEREST_BOOST；
# 模型看了觉得没兴趣会不插，连着几次就从 CHIME_BACKOFF_BASE 秒起翻倍退避
PERSONA_INTERESTS=游戏,动画,吃喝,格斗,卡牌,音乐
INTEREST_BOOST=4
CHIME_BACKOFF_BASE=120

# ---- 联网：DeepSeek 官方 Search & Fetch（0.75 美元 / 千次成功调用）----
# deepseek = 开，off = 关；SEARCH_API_KEY 留空就用 LLM_API_KEY
SEARCH_PROVIDER=deepseek
SEARCH_API_KEY=
# 只有有人跟她说话、像是要查东西时才把搜索交给模型；全局每天（学新梗那边也算在里面）、每人每小时最多查几次，同一个词几秒内用缓存
SEARCH_DAILY_MAX=1000
SEARCH_PER_USER_HOUR=6
SEARCH_CACHE_SEC=600
SEARCH_COUNT=5
# 一次回话最多查几轮；查之前先说一声「我查查」的概率
SEARCH_MAX_ROUNDS=2
SEARCH_PRELUDE_PROB=0.6

# ---- 学新梗和新东西：跟着群日记、个人日记一起从聊天里挑看不懂的梗、不认识的新游戏 / 作品 / 活动，学到的存 bot\data\slang_learned.json ----
# 挑出来的都先上网查：查得到的哪里都认，查不到的只记在原来的群 / 私聊里（不外带），没把握又查不到的不记；
# 每天最多查几个；大众的、每个会话的各最多留几条
SLANG_LEARN=1
SLANG_SEARCH_DAILY=100
SLANG_LEARNED_MAX=300
# 听得懂的梗不是每次都接：闲聊里按这个概率偶尔顺手玩一下（吵架、正事、求助、她烦了的时候不接），同一个会话至少隔几秒
SLANG_PLAY_PROB=0.1
SLANG_PLAY_GAP=1800

# ---- 主动找人：只找私聊过、「亲近」的人 ----
# 记下平时常私聊的钟点（某个钟点私聊过满 PROACTIVE_HABIT_MIN 天才算，可以有好几段）；在这些钟点里私聊没人说话满
# PROACTIVE_SILENCE_MIN 分钟（她自己主动发的也算说过话），每 PROACTIVE_CHECK_SEC 秒按 PROACTIVE_PROB 概率找一个，找点话题聊聊。
# 主动了连着几次没回就停（对方一回就清零）；全局每天最多几次。
# 常聊的钟点和沉默只看私聊，群里聊得多不算。不设免打扰时段：只在对方平时常私聊的钟点找，半夜睡觉的人那几个钟点没记录，不会去找
PROACTIVE_ENABLE=1
PROACTIVE_CHECK_SEC=600
PROACTIVE_PROB=0.3
PROACTIVE_HABIT_MIN=3
PROACTIVE_SILENCE_MIN=40
PROACTIVE_MAX_UNANSWERED=2
PROACTIVE_DAILY_MAX=6

# 没被叫时（主动插话）同一会话的冷却秒数
REPLY_COOLDOWN=5
# 未被 @ 时主动插话的概率（0 = 只在被 @ 时说话），默认档的值；聊到她感兴趣的话题 ×4，自宅档固定 100%
REPLY_CHIME_PROB=0.1
# 两次主动插话之间的最小间隔（秒），避免刚插完又插
REPLY_CHIME_COOLDOWN=300
# 被叫一次之后，这段对话还算「在聊」的时长（秒）
ENGAGE_TTL=180
# 被叫之后，别人接话多久内仍算同一段
ENGAGE_FOLLOW_WINDOW=60
# 回复时顺手配一张表情的概率（亲近的人 ×1.5；炸毛时先挑委屈、害羞的表情）
STICKER_AUTO_PROB=0.08
# 两次自动配图之间的最小间隔（秒）
STICKER_AUTO_COOLDOWN=600
# 群里要回话、而且这句有明显场景（有人抽卡歪了、卧槽、无语…）时，只甩一张对得上的表情不说话的概率
# （被 @ 和正经求助除外，找不到对得上的图就照常说话）；同群两次至少隔几秒
STICKER_ONLY_PROB=0.5
STICKER_ONLY_COOLDOWN=900
# 没有明显场景时，偶尔随手甩一张无厘头表情的概率（同样受上面的间隔限制）
STICKER_RANDOM_PROB=0.05
# 本地视觉模型（llama.cpp + Qwen3-VL-2B，一键启动会拉起，11435）：给没字的图描述一句、读懂表情包
# 关掉写 VLM_ENABLED=0（一键启动和看护也就不拉起它）；用 Ollama 的写 VLM_PROVIDER=ollama
VLM_ENABLED=1
VLM_PROVIDER=openai
# 表情读后感：库里的表情闲着时一张张读（每张隔几秒），读过存 stickers\reads.json 不再读；0 = 不在后台读
STICKER_READ=1
STICKER_READ_GAP=20
# 群友发了库里没有的表情时按喜好收藏（存进 stickers\saved）：可爱二次元 / 其它二次元 / 别的画风；
# 视觉模型没读懂时用 STICKER_SAVE_PROB。配图时先从自己收藏的里挑的概率
STICKER_SAVE_CUTE=0.5
STICKER_SAVE_ACG=0.2
STICKER_SAVE_OTHER=0.03
STICKER_SAVE_PROB=0.2
STICKER_SAVED_PREFER=0.3
STICKER_SAVE_MAX=200
# 每天清一次自己的收藏（原库不删）：发过的、可爱二次元的一直留着；
# 真不喜欢的（不是二次元也不可爱）放这么多天一次没发过才删，其余的放 STICKER_IDLE_DAYS 天一次没发过才删
STICKER_PRUNE_DAYS=30
STICKER_IDLE_DAYS=90
# 挑表情时的降权强度：用得越多越难抽中（0 = 不看次数），同分类连发再打折，池子够大时跳过上一张
STICKER_USES_FADE=0.6
STICKER_CAT_FADE=0.35
STICKER_HARD_SKIP=6
# 小本本话题自学习：单个话题权重上限（每次聊天 +1，14 天减半）
TOPIC_MAX_WEIGHT=60
# 话题多少天没提权重减半；衰减后低于这个分就不算他常聊的
TOPIC_HALF_DAYS=14
TOPIC_MIN_SCORE=1.2
# 一条消息最多塞几个热梗释义进提示词；词典和话题表放 bot\knowledge\，改文件立即生效
SLANG_HINT_MAX=3
# 小本本：每人聊几轮摘一次个人日记，群里每多少条消息、至少隔几秒摘一次群日记（0 = 关）
DIARY_USER_EVERY=4
DIARY_GROUP_EVERY=30
DIARY_GROUP_GAP=900
# 每人最多几条日记、每群最多几条关系 / 几条风格、每条最多几个字
DIARY_USER_NOTES=10
DIARY_GROUP_NOTES=12
DIARY_GROUP_STYLE=6
DIARY_NOTE_CHARS=30
# 新认识的人的初始好感 / 熟悉度（好感 0 是「陌生」档，好感到 10 才「普通」；熟悉度只有「亲近」看）
BOND_INITIAL_AFF=0
BOND_INITIAL_FAM=0
# 被追问到烦的判定：时间窗（秒）、窗口内刷屏条数（这是有好感 / 亲近的；讨厌少 2 条，陌生 / 普通少 1 条）
PESTER_WINDOW=45
PESTER_COUNT=5
# 收尾后冷处理多久（秒）
SNUB_SECONDS=100
# 早柚核心（原神/星铁/绝区零/崩坏3/鸣潮/终末地 等游戏查询，另起进程，见 docs/早柚核心接入.md）
GSUID_CORE_HOST=localhost
GSUID_CORE_PORT=8765
# 核心和机器人在同一台机器上可留空；否则要和核心 data/config.json 的 WS_TOKEN 一致
GSUID_CORE_WS_TOKEN=
# 核心重启或晚于机器人启动时自动重连（插件默认不重连）
GSUID_CORE_REPEAT=true
# 白守（BaiShou）本地 Markdown 库路径；装了 App 就指到它的库，没有也能当纯 Markdown 日记用（留空 = 文档\BaiShou）
BAISHOU_VAULT=
# 默认档的回复概率：被 @ 必回（害羞躲起来时除外）；喊名字按态度 5%~100%（这里的 0.5 是基准，改它等比缩放）；接续 = 0.3，按态度微调；私聊必回
REPLY_PROB_CALLED=0.5
REPLY_PROB_FOLLOW=0.3
# 同群两次回复的最小间隔（秒）
REPLY_GROUP_COOLDOWN=5
# 一段对话最多来回几次（默认档；自宅档不限）
ENGAGE_MAX_TURNS=4
# 早柚核心的指令前缀（英文逗号分隔）：命中的消息人设不接话、不进上下文
GAME_CMD_PREFIXES=gs,sr,zzz,bbb,ww,zmd,end,扫码登录,扫码登陆
# 群聊全局限流（条/分钟，含配图）：用到一半停插话和自动配图，3/4 停接续；被 @ 必回，不受额度限制
# 私聊、被叫触发的抽卡定型文、游戏查询等指令不受限
REPLY_PER_MIN=6
# 没被 @ 或喊名字时（接话、冒泡、只发表情）：每个群每小时最多几条（分档：用到一半停插话和配图，3/4 停接续），
# 同群两条之间至少隔几秒（默认档的值，自宅档两条都不限）。被 @ 或喊名字不受这两条限制，被 @ 必回
REPLY_GROUP_PER_HOUR=15
REPLY_CASUAL_GAP=60
# 抽卡定型文：一个 .txt 或放多个 .txt 的目录，随机挑一篇（留空 = 仓库的 gacha-texts 目录）
GACHA_TEXT_FILE=
# 抽卡模式被叫触发概率（1.8%）
REPLY_PROB_GACHA=0.018

# ---- 部署：启动/停止/自检脚本读这几项 ----
# 反向 WS 的 token，要和 SnowLuma config\onebot.json 里 wsClients 的 accessToken 一致
ONEBOT_ACCESS_TOKEN=
# SnowLuma WebUI 第一次启动时的初始密码（之后在 WebUI 里改）
SNOWLUMA_WEBUI_PASSWORD=
# 运行目录默认都在仓库里（SnowLuma\、gsuid_core\、tools\、stickers\、logs\）；
# 已经装在别处的可以指过去，相对路径按仓库根目录算
# SNOWLUMA_DIR=Z:\snowluma\SnowLuma
# GSCORE_DIR=Z:\snowluma\gsuid_core
# TOOLS_DIR=Z:\snowluma\tools
# STICKER_DIR=Z:\snowluma\stickers
# LOG_DIR=logs
# QQ_EXE=C:\Program Files\Tencent\QQNT\QQ.exe

# Bison 查开播的间隔（秒）：动态固定 60，这里也 60，开播和动态一起推不会前后脚重复
BISON_LIVE_INTERVAL_SECONDS=60
# 刚推出去的链接多久之内不交给解析插件（秒，0 不记）；只拦解析，人设照常回
PUSH_LINK_TTL=900
# 推送截图最多截多高（像素），长专栏只截开头
BILI_SHOT_MAX_HEIGHT=1600
