# 人设插件配置：复制为 persona.env 后使用
# 对应要求：像普通群友、单条 ≤20 字、不暴露 AI、口语化、有主见

# 只让这个 QQ 号发言（另一个号的事件会被忽略）
BOT_UIN=100000001
# 群友平时怎么叫它：提到这些词也算叫它（英文逗号分隔）
# 开发者：群里的酱酱鱼（不填则 /模式 /用量 等管理指令全部禁用）
DEV_UIN=100000002
DEV_NAME=酱酱鱼
NICKNAMES=酱油鱼,大肥鱼,鲸鱼娘

# 任意 OpenAI 兼容接口：DeepSeek / OpenAI / 本地 vLLM 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 单条回复上限（字）
REPLY_MAX_CHARS=20
# 每个会话保留多少条上下文
HISTORY_SIZE=24
# 没被叫时（主动插话）同一会话的冷却秒数
REPLY_COOLDOWN=8
# 未被 @ 时主动插话的概率（0 = 只在被 @ 时说话）
REPLY_CHIME_PROB=0.1
# 两次主动插话之间的最小间隔（秒），避免刚插完又插
REPLY_CHIME_COOLDOWN=300
# 被叫一次之后，这段对话还算「在聊」的时长（秒）
ENGAGE_TTL=120
# 被叫之后，别人接话多久内仍算同一段
ENGAGE_FOLLOW_WINDOW=45
# 回复时顺手配一张表情的概率（炸毛时翻倍）
STICKER_AUTO_PROB=0.08
# 两次自动配图之间的最小间隔（秒）
STICKER_AUTO_COOLDOWN=120
# 被追问到烦的判定：时间窗（秒）、窗口内条数、同一句重复次数阈值见下
PESTER_WINDOW=45
PESTER_COUNT=5
# 收尾后冷处理多久（秒）
SNUB_SECONDS=100
# 早柚核心（星铁/绝区零/崩坏3 查询，另起进程，见 docs/早柚核心接入.md）
GSUID_CORE_HOST=localhost
GSUID_CORE_PORT=8765
# 核心和机器人在同一台机器上可留空；否则要和核心 data/config.json 的 WS_TOKEN 一致
GSUID_CORE_WS_TOKEN=
# 核心重启或晚于机器人启动时自动重连（插件默认不重连）
GSUID_CORE_REPEAT=true
# 游戏数据缓存有效期（秒），过期自动重抓；抓取失败继续用旧数据
GAME_DATA_TTL=86400
# 多久检查一次是否过期（秒）
GAME_DATA_CHECK_INTERVAL=3600
# 米游社 Cookie（查体力/便笺需要；不填则相关指令只提示配置；只有 DEV_UIN 能查）
# 浏览器登录米游社 → F12 → Network → 任一请求复制 Cookie 头
MYS_COOKIE=
# 白守（BaiShou）本地 Markdown 库路径；装了 App 就指到它的库，没有也能当纯 Markdown 日记用
BAISHOU_VAULT=Z:\baishou-data\Personal
# 回复概率：被叫（喊名字/@）= 0.5，接续 = 0.15，私聊必回
REPLY_PROB_CALLED=0.5
REPLY_PROB_FOLLOW=0.15
# 同群两次回复的最小间隔（秒）
REPLY_GROUP_COOLDOWN=10
# 一段对话最多来回几次
ENGAGE_MAX_TURNS=4
# 群聊全局限流（条/分钟，含配图）：用到一半停插话和自动配图，3/4 停接续，用满才停被叫
# 私聊、被叫触发的抽卡定型文、/hsr 等指令不受限
REPLY_PER_MIN=4
# 抽卡定型文目录（放多个 .txt，随机挑一篇；留空用内置 8 篇）
GACHA_TEXT_FILE=Z:\snowluma\gacha-texts
# 抽卡模式被叫触发概率（1.8%）
REPLY_PROB_GACHA=0.018


